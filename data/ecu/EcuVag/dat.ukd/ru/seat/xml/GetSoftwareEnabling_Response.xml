<?xml version="1.0" encoding="ISO-8859-1" ?>
<MESSAGE DTD="XMLMSG" VERSION="1.4.0.0">
	<RESULT>
		<RESPONSE NAME="GetSoftwareEnabling" DTD="RepairHints" VERSION="1.4.2.1" ID="0">
			<DATA>
				<!-- Hinweis: dieses Element kommt mit ERP 4.1, folglich auch
					 mit FES 4.1 im Rahmen von CR0404. Streng genommen ist das
					 Element selbst noch nicht mit der VW-ID abgestimmt. Es
					 enthaelt die Aufruf-ID des Eintrags des fachlichen Logs
					 von service42, welcher zu dieser Antwort gehoert und soll
					 die Nachvollziehbarkeit der Reparatur erleichtern. Fuer
					 die Antwort selbst, ist die Information vorerst jedoch
					 nicht relevant. -->
				<REQUEST_ID>(REQUEST_ID)</REQUEST_ID>
				<TIMESTAMP>(TIMESTAMP_RS)</TIMESTAMP>
				<CHANGE_CODE>(CHANGE_CODE)</CHANGE_CODE>
				<FLASH_CNT>(FLASH_CNT)</FLASH_CNT>
				<REPLACE_CNT>(REPLACE_CNT)</REPLACE_CNT>
				<CODING_CNT>(CODING_CNT)</CODING_CNT>
				<PARAMETRIZE_CNT>(PARAMETRIZE_CNT)</PARAMETRIZE_CNT>
				<ADJUST_CALIBRATE_CNT>(ADJUST_CALIBRATE_CNT)</ADJUST_CALIBRATE_CNT>
				<INSTALLATIONLISTCODING_CNT>(INSTALLATIONLISTCODING_CNT)</INSTALLATIONLISTCODING_CNT>
				<COMBINATION_IND>(COMBINATION_IND)</COMBINATION_IND>
				<NOTE KEY="(NOTE_KEY)"/>
				<NEXT>
					<TASK_CODE>(TASK_CODE_RS)</TASK_CODE>
					<CHANGE_CODE>(CHANGE_CODE_RS)</CHANGE_CODE>
					<COMPONENT_REF>(COMPONENT_REF)</COMPONENT_REF>
				</NEXT>
				<VEHICLE STATUS="repair">
					<IDENT>
						<VIN>(VEHICLE_IDENT_NO)</VIN>
					</IDENT>
					<LIFE_DATA>
						<!-- Hinweis: Die Uebertragung der GVL-Codierung ueber das Element GATEWAY_CODING gilt als
							 deprecated. Zukuenftig wird eine (G)VL-Codierung ueber die Elemente INSTALLATIONLISTCODING
							 unterhalb von COMPONENT uebertragen. In einer Uebergangszeit wird weiterhin zusaetzlich
							 GATEWAY_CODING gefuellt, sollte an DA19 eine VL-Codierung vorgeschlagen werden. Bei 
							 Neuentwicklungen sollte jedoch dieses Element nicht mehr beruecksichtigt werden. -->
						<GATEWAY_CODING LOGIN="(GATEWAY_LOGIN)" LOGIN_IND="(GATEWAY_LOGIN_IND)">(GATEWAY_CODING)</GATEWAY_CODING>
					</LIFE_DATA>
					<EQUIPMENT>
						<PR TABLE="1" FAMILY="(PR_FAMILY_1)" PR_ID="(PR_ID_1)" />
						<PR TABLE="2" FAMILY="(PR_FAMILY_2)" PR_ID="(PR_ID_2)" />
						<PR TABLE="3" FAMILY="(PR_FAMILY_3)" PR_ID="(PR_ID_3)" />
						<PR TABLE="4" FAMILY="(PR_FAMILY_4)" PR_ID="(PR_ID_4)" />
						<PR TABLE="5" FAMILY="(PR_FAMILY_5)" PR_ID="(PR_ID_5)" />
					</EQUIPMENT>
				 	*(
					<COMPONENT TYPE="(COMPONENT_TYPE_RS)" ID="(COMPONENT_ID_RS)" HW_UPDATE="(HW_UPDATE_RS)" SW_UPDATE="(SW_UPDATE_RS)" CODE="(CODE_RS)" PARAMETRIZE="(PARAMETRIZE_RS)" ILCODE="(ILCODE_RS)" ADJUST_CALIBRATE="(ADJUST_CALIBRATE_RS)" STATE="(STATE_RS)" LOGICAL_LINK="(LOGICAL_LINK_RS)" SLAVE_ID="(SLAVE_ID_RS)" RDI="(RDI_RS)" SID="(SID_RS)" SWE_ENABLING="(SWE_ENABLING_RS)">
						<ECU_PART_NO>(ECU_PART_NO_RS)</ECU_PART_NO>
						<HW_PART_NO>(HW_PART_NO_RS)</HW_PART_NO>
						<HW_VERSION>(HW_VERSION_RS)</HW_VERSION>
						<SW_VERSION>(SW_VERSION_RS)</SW_VERSION>
						<CODING LOGIN="(CODING_LOGIN_RS)" LOGIN_IND="(CODING_LOGIN_IND_RS)" CODING_ID="(CODING_ID_RS)" VARIANT="(CODING_VARIANT_RS)" SEQUENCE_NO="(CODING_SEQUENCE_NO_RS)">(CODING_RS)</CODING>
						<PARAMETRIZING ZDC_NAME="(PARAMETRIZING_ZDC_NAME_RS)" ZDC_VERSION="(PARAMETRIZING_ZDC_VERSION_RS)" PR_IDX="(PARAMETRIZING_PR_IDX_RS)" LOGIN="(PARAMETRIZING_LOGIN_RS)" LOGIN_IND="(PARAMETRIZING_LOGIN_IND_RS)"/>
						<FLASHING SEQUENCE_NO="(FLASHING_SEQUENCE_NO_RS)" MEDIA="(FLASHING_MEDIA_RS)" FILENAME="(FLASHING_FILENAME_RS)" LOGIN="(FLASHING_LOGIN_RS)" LOGIN_IND="(FLASHING_LOGIN_IND_RS)"/>
						<ADJUST_CALIBRATING ZDC_NAME="(ADJUST_CALIBRATING_ZDC_NAME_RS)" ZDC_VERSION="(ADJUST_CALIBRATING_ZDC_VERSION_RS)" LOGIN="(ADJUST_CALIBRATING_LOGIN_RS)" LOGIN_IND="(ADJUST_CALIBRATING_LOGIN_IND_RS)" />
						<INSTALLATIONLISTCODING LOGIN="(INSTALLATIONLISTCODING_LOGIN_RS)" LOGIN_IND="(INSTALLATIONLISTCODING_LOGIN_IND_RS)">(INSTALLATIONLISTCODING_RS)</INSTALLATIONLISTCODING>
						<NOTE>(NOTE)</NOTE>
					</COMPONENT>
					)*
				</VEHICLE>
				<INFORMATION>
					<CODE>(INFORMATION_CODE)</CODE>
				</INFORMATION>
			</DATA>
	</RESPONSE>
	</RESULT>
</MESSAGE>
